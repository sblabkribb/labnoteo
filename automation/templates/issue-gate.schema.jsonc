{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "issue-gate verdict",
  "description": "Structured verdict returned by the Phase 4b AI issue gate.",
  "type": "object",
  "additionalProperties": false,
  "required": ["needs_issue", "reason"],
  "properties": {
    "needs_issue": {
      "type": "boolean",
      "description": "True when this experiment warrants opening a discussion issue."
    },
    "reason": {
      "type": "string",
      "description": "Short one-sentence justification (Korean)."
    }
  }
}
